{
  "name": "@emotion-studio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:dependencies": "npm --prefix ../.. run build -w @emotion-studio/contracts && npm --prefix ../.. run build -w @emotion-studio/database",
    "predev": "npm run build:dependencies",
    "dev": "tsx watch src/server.ts",
    "premcp:dev": "npm run build:dependencies",
    "mcp:dev": "tsx watch src/mcp/http.ts",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "mcp:start": "node dist/mcp/http.js",
    "prebuild": "npm run build:dependencies",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:dependencies",
    "test": "vitest run",
    "start": "node dist/server.js",
    "persistence": "tsx src/content/persistence-cli.ts"
  },
  "dependencies": {
    "@emotion-studio/contracts": "0.1.0",
    "@emotion-studio/database": "0.1.0",
    "@fastify/cors": "^11.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "playwright": "^1.63.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
