{
  "name": "emotion-content-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n API,WEB -c blue,magenta \"npm run dev -w @emotion-studio/api\" \"npm run dev -w @emotion-studio/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:contracts": "npm run test -w @emotion-studio/contracts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  }
}
