NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# Read-only Growth Loop MCP server (Streamable HTTP at http://HOST:MCP_PORT/mcp).
# Keep 127.0.0.1 locally; bind 0.0.0.0 only behind a trusted private tunnel/reverse proxy.
MCP_HOST=127.0.0.1
MCP_PORT=8790
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://emotion_studio:change-me@localhost:5434/emotion_studio
CONTENT_REPOSITORY=sqlite
SQLITE_PATH=data/emotion-studio.sqlite
AI_PROVIDER=mock
# Network models require explicit opt-in; keep false for local Mock/Demo use.
AI_ALLOW_PAID_CALLS=false
AI_API_KEY=
# Set an explicit model only when selecting openai-compatible.
# AI_MODEL=your-json-capable-model
AI_BASE_URL=https://api.openai.com/v1
AI_FALLBACK=mock
AI_USAGE_PATH=data/ai-usage.jsonl
AI_COST_CURRENCY=USD
# Optional, user-supplied prices; unknown cost stays null (not zero).
# AI_INPUT_PRICE_PER_MILLION=1.00
# AI_OUTPUT_PRICE_PER_MILLION=2.00
ENGLISH_AI_MODE=demo
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=15000
AI_MAX_ATTEMPTS=3
LOG_LEVEL=info
